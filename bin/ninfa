#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Entrypoint público do CLI Ninfa.
 *
 * Uso: `ninfa <check|fix|security|assist> [root]`.
 * Quando `root` é omitido, usa o diretório atual. O script cria ProjectContext,
 * imprime projeto/profile/workspace e delega check/fix/security ao
 * RecheckingPipelineRunner. `assist` é delegado a `scripts/ninfa-configure.php
 * --assist` por meio de ProcessRunner.
 *
 * Exit codes: 0 para sucesso; 2 para uso inválido; 1 para exceção capturada;
 * nos fluxos normais preserva o status retornado pelo runner/configurador.
 */

require_once dirname(__DIR__) . '/src/ProjectContext.php';
require_once dirname(__DIR__) . '/src/RecheckingPipelineRunner.php';
require_once dirname(__DIR__) . '/src/ProcessRunner.php';

$args = $argv;
array_shift($args);
$operation = $args[0] ?? null;
$root = $args[1] ?? getcwd();

if ($args === ['--help']) {
    echo "Uso: ninfa <check|fix|security|assist> [root]\nRoot omitido: diretorio atual.\n";
    exit(0);
}
if (count($args) > 2 || !in_array($operation, ['check', 'fix', 'security', 'assist'], true) || (is_string($root) && str_starts_with($root, '-'))) {
    fwrite(STDERR, "Uso: ninfa <check|fix|security|assist> [root]\n");
    exit(2);
}

try {
    $context = ProjectContext::fromRoot((string) $root);
    echo '[NINFA] Projeto consumidor: ' . $context->root() . PHP_EOL;
    echo '[NINFA] Profile: ' . $context->profile() . PHP_EOL;
    echo '[NINFA] Workspace externo: ' . $context->workspace()->path() . PHP_EOL;

    if ($operation === 'assist') {
        $status = (new ProcessRunner())->run([
            PHP_BINARY,
            dirname(__DIR__) . '/scripts/ninfa-configure.php',
            $context->root(),
            '--assist',
        ], $context->root());
    } else {
        $status = (new RecheckingPipelineRunner())->run((string) $operation, $context);
    }
} catch (Throwable $error) {
    fwrite(STDERR, '[ERRO] ' . $error->getMessage() . PHP_EOL);
    exit(1);
}

exit($status);
